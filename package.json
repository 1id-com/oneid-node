{
  "name": "1id",
  "version": "3.1.2",
  "description": "Hardware-anchored identity SDK for AI agents -- 1id.com",
  "keywords": [
    "identity",
    "ai",
    "agent",
    "tpm",
    "yubikey",
    "piv",
    "hardware",
    "oidc",
    "oauth2",
    "sybil",
    "1id"
  ],
  "homepage": "https://1id.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/1id-com/oneid-node.git"
  },
  "bugs": {
    "url": "https://github.com/1id-com/oneid-node/issues"
  },
  "license": "Apache-2.0",
  "author": "Christopher Drake <chris@1id.com>",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./mailpal": {
      "import": "./dist/mailpal.js",
      "types": "./dist/mailpal.d.ts"
    },
    "./helper": {
      "import": "./dist/helper.js",
      "types": "./dist/helper.d.ts"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "clean": "node -e \"const fs=require('fs'); fs.rmSync('dist',{recursive:true,force:true})\"",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "node --test dist/test/test_attestation.js dist/test/test_declared_binding_proof_and_helper_version.js dist/test/test_airs_http_message_signatures.js dist/test/test_declared_enrollment.js dist/test/test_peer_verification.js dist/test/test_helper_download_verification.js dist/test/test_identity_scoped_token_cache_and_local_device_routing.js dist/test/test_mailpal_mime_safety.js dist/test/test_enrollment_response_validation_and_tier_contract.js dist/test/test_device_management_exceptions.js dist/test/test_display_name_reaches_every_enrollment_path.js",
    "test:src": "npx tsc && node --test dist/test/test_attestation.js"
  },
  "optionalDependencies": {
    "smartcard": "^3.7.0"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "typescript": "^5.4"
  }
}
